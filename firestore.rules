rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function validResponse(data) {
      return data.keys().hasOnly([
          'centerName',
          'stage',
          'outcome',
          'recommendations',
          'song',
          'openAnswer',
          'status',
          'createdAt',
          'approvedAt'
        ])
        && data.keys().hasAll([
          'centerName',
          'stage',
          'outcome',
          'recommendations',
          'song',
          'openAnswer',
          'status',
          'createdAt'
        ])
        && data.centerName is string
        && data.centerName.size() >= 1
        && data.centerName.size() <= 120
        && data.stage in ['Infantil', 'Primària', 'ESO', 'Altres']
        && data.outcome in ['Molt bé', 'Bé', 'Regular', 'Ens ha costat']
        && data.song in [
          'Shut Up and Dance',
          'Happy',
          'Only Human',
          "Don't Start Now",
          "CAN'T STOP THE FEELING!",
          'Blinding Lights',
          'My Way',
          'Sucker'
        ]
        && data.recommendations is list
        && data.recommendations.size() >= 1
        && data.recommendations.size() <= 6
        && data.recommendations.hasOnly([
          'Fer una prova tècnica abans de començar',
          'Començar amb una cançó o nivell fàcil',
          'Projectar la pantalla ben gran i visible',
          'Organitzar torns i grups petits',
          'Adaptar els passos a les necessitats del grup',
          'Fer una demostració abans de jugar'
        ])
        && data.recommendations.toSet().size() == data.recommendations.size()
        && data.openAnswer is string
        && data.openAnswer.size() <= 1000
        && data.status in ['pending', 'approved']
        && data.createdAt is timestamp
        && (data.status == 'pending'
          ? !('approvedAt' in data)
          : data.approvedAt is timestamp);
    }

    match /communityResponses/{responseId} {
      allow read: if isAdmin()
        || ('status' in resource.data && resource.data.status == 'approved');
      allow create: if validResponse(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !('approvedAt' in request.resource.data);
      allow update: if isAdmin()
        && (!('status' in resource.data) || resource.data.status == 'pending')
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'approvedAt', 'centerName'])
        && validResponse(request.resource.data);
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}
